# Пример файла настроек. Скопируйте в .env и измените под себя.
# Переменные читаются всеми частями работы, аргументы CLI имеют приоритет.

# --- общие ---
NN_DATA_PATH=./data/input
NN_OUTPUT_DIR=./data/output
NN_LOG_LEVEL=INFO

# --- часть 1: перцептрон ---
NN_TEST_RATIO=0.2
NN_WEIGHTS_PATH=./data/output/part1_weights.json
NN_PLOT_PATH=./logs/part1_loss.png
NN_SEED=42

# --- часть 2: подготовка данных ---
NN_IMAGE_SIZE=64x64
NN_EXTENSIONS=.png,.jpg,.jpeg,.bmp
NN_OUTPUT_FILE=dataset.npy

# --- часть 3: параллельная обработка ---
NN_AUG_PATH=./data/input/aug_images
NN_WORKERS=4
NN_PROCESSES=4
